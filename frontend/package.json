{
  "name": "neurosplit-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "Phase 2 — interactive cortical visualization of TRIBE v2 predicted responses.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:comparison": "node scripts/benchmark-comparison-browser.mjs",
    "verify": "npm run typecheck && npm test && npm run test:e2e:comparison",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "playwright": "^1.56.1",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.13": true,
    "esbuild@0.28.2": true
  }
}
