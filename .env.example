# BlackMirror configuration.
# Copy to `.env` and edit. `.env` is gitignored — never commit secrets.
# Every variable is optional; defaults are in src/blackmirror/config/settings.py.

# --- Backend / model ---------------------------------------------------------
# tribe_v2 (real predictions) | mock (SYNTHETIC test data)
BLACKMIRROR_BACKEND=tribe_v2
BLACKMIRROR_MODEL_ID=facebook/tribev2
BLACKMIRROR_CHECKPOINT_NAME=best.ckpt
# Feature-extraction cache. Grows to several GB.
BLACKMIRROR_MODEL_CACHE_DIR=./cache

# Override the frozen TEXT encoder. Leave unset to use the checkpoint's own
# meta-llama/Llama-3.2-3B (GATED — needs an accepted license + HF_TOKEN below).
# Must be the SAME model; recorded in the model fingerprint so runs with
# different text encoders are treated as non-comparable.
# BLACKMIRROR_TEXT_ENCODER_ID=unsloth/Llama-3.2-3B
#
# PIN THIS ONCE AND DO NOT CHANGE IT MID-CORPUS. The value lands in the model
# fingerprint, and Phase 6 refuses to score variants whose fingerprints differ.
# Changing it — including letting it fall back to the gated repo after an access
# request is finally granted — splits your artifacts into two halves that cannot
# be compared with each other, and nothing says so until a score fails hours
# later. An ungated mirror of the same weights still counts as different here,
# because a repo id is not proof that two sets of weights are identical.

# --- Compute -----------------------------------------------------------------
# auto | cuda | cpu   (mps is NOT supported by TRIBE v2)
BLACKMIRROR_DEVICE=auto
# false => an unsatisfiable CUDA request errors instead of silently using CPU
BLACKMIRROR_ALLOW_CPU_FALLBACK=true
BLACKMIRROR_DTYPE=float32

# --- Preprocessing -----------------------------------------------------------
# true (upstream default) drops event-free segments, making the prediction time
# axis non-uniform. Segment offsets are always persisted either way.
BLACKMIRROR_REMOVE_EMPTY_SEGMENTS=true
# false => REDUCED-MODALITY run (no text stream); not comparable with full runs.
BLACKMIRROR_ENABLE_TRANSCRIPTION=true

# --- Storage -----------------------------------------------------------------
BLACKMIRROR_ARTIFACT_DIR=./artifacts
BLACKMIRROR_REUSE_CACHED_RUNS=false

# --- Observability -----------------------------------------------------------
BLACKMIRROR_LOG_LEVEL=INFO
BLACKMIRROR_RANDOM_SEED=1234

# --- Platform ----------------------------------------------------------------
# Apply documented macOS/Apple-Silicon patches to TRIBE's transcription step.
# Every applied patch is recorded in the run provenance.
BLACKMIRROR_ENABLE_MACOS_COMPAT=true

# --- Secrets -----------------------------------------------------------------
# TRIBE's text stream uses the GATED meta-llama/Llama-3.2-3B, and pyannote's
# diarization models are gated too.
#
# DO NOT put HF_TOKEN in this file. Settings are read with env_prefix
# "BLACKMIRROR_" and extra="ignore", so an unprefixed HF_TOKEN here is parsed,
# discarded, and never exported to os.environ -- which is the only place
# huggingface_hub looks. It would fail silently with a 401 at download time.
#
# Install the token one of these two ways instead:
#   hf auth login                 # writes ~/.cache/huggingface/token (persistent)
#   export HF_TOKEN=hf_...        # shell environment (per session)
#
# 1) Accept the licences you need:
#      https://huggingface.co/meta-llama/Llama-3.2-3B
#      https://huggingface.co/pyannote/segmentation-3.0
#      https://huggingface.co/pyannote/speaker-diarization-3.1
#      https://huggingface.co/pyannote/overlapped-speech-detection
# 2) Create a READ token: https://huggingface.co/settings/tokens
